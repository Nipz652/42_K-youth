# Virtual environments
.venv/
venv/
env/

# Environment variables - NEVER commit secrets
.env
backend/.env
frontend/.env
landing/.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# uv cache
.uv/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Docker
*.log

# Distribution / packaging
dist/
build/
*.egg-info/

# Docker secrets — never commit actual secret files
secrets/*.txt
secrets/*.key
secrets/*.pem
secrets/

# Keep the README so people know the folder exists
!secrets/README.md
# Don't copy venv - Docker installs its own
.venv/
venv/

# Don't expose secrets
.env

# Python cache - not needed in container
__pycache__/
*.pyc
*.pyo

# Git files - not needed in container
.git/
.gitignore

# Documentation - not needed in container
README.md

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Secrets never get baked into the image
secrets/
